        w.configure(bg=BG)
        w.geometry('780x650')
        w.transient(self.r)
        
        q = 'В предложении «Уставший после уроков кот быстро уснул на подоконнике» назовите грамматическую основу.'
        
        self.ensure_projector()
        self.clear(self.projector)
        
        self.lab(self.projector, 'ФИНАЛЬНЫЙ ВОПРОС', 32, GOLD, bold=True).pack(pady=(100, 20))
        self.lab(self.projector, 'ТЕМА: СИНТАКСИС', 22, CYAN, bold=True).pack(pady=15)
        self.lab(self.projector, q, 36, WHITE, bold=True, wraplength=1100, justify='center').pack(expand=True, padx=60)
        
        self.lab(w, 'ТОЛЬКО ДЛЯ ВЕДУЩЕГО', 12, CYAN, bold=True).pack(pady=15)
        self.lab(w, 'ОТВЕТ: КОТ УСНУЛ', 20, GREEN, bold=True).pack(pady=10)
        
        entries = []
        for i, n in enumerate(self.names):
            row = tk.Frame(w, bg=BG)
            row.pack(pady=8)
            self.lab(row, n, 14, WHITE).pack(side='left', padx=10)
            e = tk.Entry(row, width=12, justify='center', bg=BLUE, fg=WHITE, relief='flat', bd=5, font=(FONT_MAIN, 14))
            e.insert(0, '0')
            e.pack(side='left')
            entries.append(e)
            
        def finish():
            try:
                bs = [int(e.get()) for e in entries]
                assert all(0 <= bs[i] <= max(0, self.scores[i]) for i in range(3))
            except:
                messagebox.showerror('Ставка', 'Ставка должна быть от 0 до текущего счёта.')
                return
                
            for i in range(3):
                if messagebox.askyesno('Ответ команды', f'{self.names[i]} ответила правильно?', parent=w):
                    self.scores[i] += bs[i]
                else:
                    self.scores[i] -= bs[i]
                    
            w.destroy()
            self.host_board()
            self.projector_board('ИТОГИ ИГРЫ')
            winner = max(range(3), key=lambda i: self.scores[i])
            messagebox.showinfo('Итоги', f'🏆 Победитель: {self.names[winner]}\n\n' + '\n'.join(f'{self.names[i]}: {self.scores[i]}' for i in range(3)))
            
        tk.Button(w, text='ПОДВЕСТИ ИТОГИ', command=finish, bg=GOLD, fg=BG, relief='flat', bd=0, font=(FONT_MAIN, 13, 'bold'), padx=20, pady=10).pack(pady=25)

if __name__ == '__main__':
    root = tk.Tk()
    Game(root)
    root.mainloop()
