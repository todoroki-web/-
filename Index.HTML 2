class Game:
    def __init__(self, root):
        self.r = root
        root.title('СВОЯК — Пульт ведущего')
        root.geometry('1000x760')
        root.configure(bg=BG)
        
        self.names = ['Команда 1', 'Команда 2', 'Команда 3']
        self.scores = [0, 0, 0]
        self.used = set()
        
        self.projector = tk.Toplevel(root)
        self.projector.title('СВОЯК — Экран для проектора')
        self.projector.configure(bg=BG)
        self.projector.protocol("WM_DELETE_WINDOW", self.close_projector)
        
        self._place_projector_on_second_monitor()
        self.make_start()

    def ensure_projector(self):
        if not self.projector.winfo_exists():
            self.projector = tk.Toplevel(self.r)
            self.projector.title('СВОЯК — Экран для проектора')
            self.projector.configure(bg=BG)
            self.projector.protocol("WM_DELETE_WINDOW", self.close_projector)
            self._place_projector_on_second_monitor()
        self.projector.deiconify()

    def close_projector(self):
        self.projector.withdraw()

    def _place_projector_on_second_monitor(self):
        try:
            import ctypes
            from ctypes import wintypes
            
            monitors = []
            def collect(hmon, hdc, rect, data):
                r = rect.contents
                monitors.append((r.left, r.top, r.right - r.left, r.bottom - r.top))
                return 1
                
            MONITORENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_int, wintypes.HMONITOR, wintypes.HDC, ctypes.POINTER(wintypes.RECT), wintypes.LPARAM)
            ctypes.windll.user32.EnumDisplayMonitors(0, 0, MONITORENUMPROC(collect), 0)
            
            if len(monitors) > 1:
                target = monitors[1]
                for m in monitors:
                    if m[0] != 0 or m[1] != 0:
                        target = m
                        break
                x, y, w, h = target
                self.projector.geometry(f'{w}x{h}+{x}+{y}')
                self.projector.overrideredirect(True) 
            else:
                self.projector.geometry('1280x720+100+100')
        except Exception:
            self.projector.geometry('1280x720+1000+0')

    def clear(self, w):
        try:
            if w.winfo_exists():
                for x in w.winfo_children():
                    x.destroy()
        except Exception:
            pass

    def lab(self, p, t, size=14, color=TEXT, bg=BG, bold=False, **kw):
        return tk.Label(p, text=t, font=(FONT, size, 'bold' if bold else 'normal'), fg=color, bg=bg, **kw)

    def make_start(self):
        self.clear(self.r)
        f = tk.Frame(self.r, bg=BG)
        f.pack(expand=True)
        
        self.lab(f, 'С В О Я К', 56, ORANGE, bold=True).pack(pady=(40, 5))
        self.lab(f, 'ПУЛЬТ ВЕДУЩЕГО', 18, TEXT, bold=True).pack(pady=(0, 40))
        self.lab(f, 'ВВЕДИТЕ НАЗВАНИЯ КОМАНД', 14, '#888888').pack(pady=(10, 15))
        
        self.entries = []
        for i in range(3):
            e = tk.Entry(f, font=(FONT, 20), justify='center', width=25, bg=PANEL, fg=TEXT, insertbackground=ORANGE, relief='flat', bd=10)
            e.insert(0, self.names[i])
            e.pack(pady=10)
            self.entries.append(e)
            
        tk.Button(f, text='НАЧАТЬ ИГРУ', font=(FONT, 20, 'bold'), bg=ORANGE, fg=BG, activebackground=ORANGE_HOVER, activeforeground=BG, relief='flat', bd=0, command=self.start, padx=50, pady=15).pack(pady=40)
        
        self.projector_board('ОЖИДАНИЕ НАЧАЛА ИГРЫ')

    def start(self):
        self.names = [e.get().strip() or f'Команда {i+1}' for i, e in enumerate(self.entries)]
        self.host_board()
        self.projector_board()

    def host_board(self):
        self.clear(self.r)
        top = tk.Frame(self.r, bg=BG)
        top.pack(fill='x', padx=20, pady=20)
        self.lab(top, 'ПУЛЬТ ВЕДУЩЕГО', 24, ORANGE, bold=True).pack(side='left')
        tk.Button(top, text='МОДИФИКАТОРЫ', command=self.modifiers, bg=PANEL, fg=ORANGE, relief='flat', bd=0, font=(FONT, 12, 'bold'), padx=15, pady=8).pack(side='right')
        
        sf = tk.Frame(self.r, bg=BG)
        sf.pack(fill='x', padx=20, pady=10)
        for i in range(3):
            p = tk.Frame(sf, bg=PANEL)
            p.pack(side='left', expand=True, fill='x', padx=8)
            self.lab(p, self.names[i], 15, TEXT, PANEL, True).pack(pady=(12, 4))
            self.lab(p, str(self.scores[i]), 40, ORANGE, PANEL, True).pack(pady=(0, 12))
            
        btn_style = {'bg': PANEL, 'fg': TEXT, 'activebackground': ORANGE, 'activeforeground': BG, 'relief': 'flat', 'bd': 0, 'font': (FONT, 14, 'bold'), 'padx': 20, 'pady': 12}
        
        tk.Button(self.r, text='ПОКАЗАТЬ ТАБЛО НА ПРОЕКТОРЕ', command=self.projector_board, **btn_style).pack(pady=15)
        tk.Button(self.r, text='ФИНАЛЬНЫЙ ВОПРОС', command=self.final, bg=ORANGE, fg=BG, activebackground=ORANGE_HOVER, activeforeground=BG, relief='flat', bd=0, font=(FONT, 16, 'bold'), padx=25, pady=15).pack(pady=15)
        
        tk.Button(self.r, text='Скрыть/Показать проектор', command=self.toggle_full, bg=BG, fg='#555555', relief='flat', bd=0, font=(FONT, 11)).pack(pady=20)

    def toggle_full(self):
        self.ensure_projector()
        if self.projector.state() == 'normal':
            self.close_projector()
        else:
            self.projector.deiconify()

    def projector_board(self, status=''):
        self.ensure_projector()
        self.clear(self.projector)
        
        # --- ВЕРХНЯЯ ПАНЕЛЬ ---
        top = tk.Frame(self.projector, bg=BG)
        top.pack(fill='x', padx=40, pady=20)
        self.lab(top, 'С В О Я К', 54, ORANGE, bold=True).pack(side='left')
        self.lab(top, 'РАУНД 1', 24, TEXT, bold=True).pack(side='right', pady=10)
        
        # --- ТАБЛО КОМАНД ---
        sf = tk.Frame(self.projector, bg=BG)
        sf.pack(fill='x', padx=30, pady=10)
        for i in range(3):
            p = tk.Frame(sf, bg=PANEL)
            p.pack(side='left', expand=True, fill='x', padx=10)
            self.lab(p, self.names[i], 20, TEXT, PANEL, True).pack(pady=(15, 5))
            self.lab(p, str(self.scores[i]), 50, ORANGE, PANEL, True).pack(pady=(0, 15))
            
        if status:
            self.lab(self.projector, status, 24, ORANGE, bold=True).pack(pady=20)
            
        # --- СЕТКА ВОПРОСОВ (Идеально ровная) ---
        grid = tk.Frame(self.projector, bg=BG)
        grid.pack(expand=True, fill='both', padx=20, pady=15)
        
        for c, cat in enumerate(CATS):
            # Заголовки категорий
            cat_lbl = tk.Label(grid, text=cat, font=(FONT, 14, 'bold'), fg=BG, bg=ORANGE if cat == 'ШЛАКОБЛОКУНЬ' else TEXT, height=2, wraplength=180)
            cat_lbl.grid(row=0, column=c, sticky='nsew', padx=4, pady=(0, 8))
            # Жестко фиксируем ширину колонок
            grid.grid_columnconfigure(c, weight=1, uniform="col")
            
            for rr in range(10):
                key = (c, rr)
                special = SPECIAL.get(key, '')
                
                if key in self.used:
                    text = '✓'
                    btn_bg = USED_BTN
                    btn_fg = '#333333'
                else:
                    text = f"{str((rr + 1) * 100)}\n{special}" if special else str((rr + 1) * 100)
                    btn_bg = PANEL
                    btn_fg = ORANGE
                
                btn = tk.Button(grid, text=text, font=(FONT, 20, 'bold'), 
                                bg=btn_bg, fg=btn_fg, 
                                activebackground=ORANGE, activeforeground=BG, 
                                relief='flat', bd=0, 
                                command=lambda x=c, y=rr: self.question(x, y), 
                                state='disabled' if key in self.used else 'normal')
                btn.grid(row=rr + 1, column=c, sticky='nsew', padx=4, pady=3)
                # Жестко фиксируем высоту строк
                grid.grid_rowconfigure(rr + 1, weight=1, uniform="row")

    def modifiers(self):
        w = tk.Toplevel(self.r)
        w.title('Модификаторы')
        w.configure(bg=BG)
        w.geometry('750x550')
        w.transient(self.r)
        self.lab(w, 'МОДИФИКАТОРЫ', 28, ORANGE, bold=True).pack(pady=25)
        for n, d in MODS:
            f = tk.Frame(w, bg=PANEL)
            f.pack(fill='x', padx=25, pady=6)
            self.lab(f, n, 16, ORANGE, PANEL, True).pack(anchor='w', padx=15, pady=(10, 2))
            self.lab(f, d, 13, TEXT, PANEL, wraplength=650, justify='left').pack(anchor='w', padx=15, pady=(0, 10))

    def question(self, c, r):
        key = (c, r)
        if key in self.used:
            return
        self.used.add(key)
        q, a = Q[c][r]
        v = (r + 1) * 100
        sp = SPECIAL.get(key, '')
        
        self.ensure_projector()
        self.clear(self.projector)
        
        # --- ПРОЕКТОР: ВОПРОС ---
        self.lab(self.projector, CATS[c], 32, ORANGE, bold=True).pack(pady=(100, 10))
        
        if sp:
            self.lab(self.projector, sp, 28, TEXT, bg=ORANGE, bold=True, padx=20, pady=5).pack(pady=15)
            
        self.lab(self.projector, f'{v} БАЛЛОВ', 24, TEXT, bold=True).pack(pady=15)
        
        self.lab(self.projector, q, 50, TEXT, bold=True, wraplength=1400, justify='center').pack(expand=True, padx=60)
        
        self.lab(self.projector, 'СОВЕЩАНИЕ…', 22, '#666666').pack(pady=80)
        
        # --- ПУЛЬТ ВЕДУЩЕГО (Окно) ---
        w = tk.Toplevel(self.r)
        w.title('Ответ ведущего')
        w.configure(bg=BG)
        w.geometry('780x650')
        w.transient(self.r)
        
        self.lab(w, 'ОТВЕТ СКРЫТ ОТ ИГРОКОВ', 14, ORANGE, bold=True).pack(pady=(25, 10))
        self.lab(w, f'{CATS[c]} • {v} баллов', 18, TEXT, bold=True).pack(pady=5)
        if sp:
            self.lab(w, f'МОДИФИКАТОР: {sp}', 18, TEXT, bg=ORANGE, bold=True, padx=10, pady=3).pack(pady=10)
            
        self.lab(w, q, 22, TEXT, bold=True, wraplength=700, justify='center').pack(pady=25, padx=20)
        self.lab(w, f'ОТВЕТ:\n{a}', 28, GREEN, bold=True, wraplength=700, justify='center').pack(pady=20)
        
        def award(i, ok):
            stake = v
            if sp == 'АУКЦИОН':
                x = simpledialog.askinteger('Аукцион', 'Ставка команды (0–1000):', parent=w, minvalue=0, maxvalue=1000)
                if x is None: return
                stake = x
            if sp == 'ВА-БАНК':
                stake = max(0, self.scores[i])
            if sp == 'УДВОЕНИЕ' and ok:
                stake *= 2
            self.scores[i] += stake if ok else -stake
            w.destroy()
            self.host_board()
            self.projector_board()
            
        frame = tk.Frame(w, bg=BG)
        frame.pack(pady=15)
        for i, n in enumerate(self.names):
            row = tk.Frame(frame, bg=BG)
            row.pack(pady=8)
            self.lab(row, n, 16, TEXT).pack(side='left', padx=15)
            tk.Button(row, text='ВЕРНО +', command=lambda j=i: award(j, True), bg=GREEN, fg=BG, relief='flat', bd=0, font=(FONT, 13, 'bold'), padx=15, pady=5).pack(side='left', padx=5)
            tk.Button(row, text='НЕВЕРНО −', command=lambda j=i: award(j, False), bg=RED, fg=TEXT, relief='flat', bd=0, font=(FONT, 13, 'bold'), padx=15, pady=5).pack(side='left', padx=5)
            
        tk.Button(w, text='ЗАКРЫТЬ БЕЗ НАЧИСЛЕНИЯ', command=lambda: (w.destroy(), self.host_board(), self.projector_board()), bg=PANEL, fg=TEXT, relief='flat', bd=0, font=(FONT, 12, 'bold'), padx=20, pady=10).pack(pady=25)

    def final(self):
        w = tk.Toplevel(self.r)
        w.title('ФИНАЛ')
        w.configure(bg=BG)
        w.geometry('780x650')
        w.transient(self.r)
        
        q = 'В предложении «Уставший после уроков кот быстро уснул на подоконнике» назовите грамматическую основу.'
        
        self.ensure_projector()
        self.clear(self.projector)
        
        self.lab(self.projector, 'ФИНАЛЬНЫЙ ВОПРОС', 40, ORANGE, bold=True).pack(pady=(120, 20))
        self.lab(self.projector, 'ТЕМА: СИНТАКСИС', 28, TEXT, bold=True).pack(pady=15)
        self.lab(self.projector, q, 50, TEXT, bold=True, wraplength=1400, justify='center').pack(expand=True, padx=60)
        
        self.lab(w, 'ФИНАЛ (ОТВЕТ СКРЫТ)', 16, ORANGE, bold=True).pack(pady=15)
        self.lab(w, 'ОТВЕТ: КОТ УСНУЛ', 24, GREEN, bold=True).pack(pady=15)
        
        entries = []
        for i, n in enumerate(self.names):
            row = tk.Frame(w, bg=BG)
            row.pack(pady=10)
            self.lab(row, n, 16, TEXT).pack(side='left', padx=15)
            e = tk.Entry(row, width=12, justify='center', bg=PANEL, fg=TEXT, relief='flat', bd=8, font=(FONT, 18, 'bold'))
            e.insert(0, '0')
            e.pack(side='left')
            entries.append(e)
            
        def finish():
            try:
                bs = [int(e.get()) for e in entries]
                assert all(0 <= bs[i] <= max(0, self.scores[i]) for i in range(3))
            except:
                messagebox.showerror('Ставка', 'Ставка должна быть от 0 до текущего счёта.')
                return
                
            for i in range(3):
                if messagebox.askyesno('Ответ команды', f'{self.names[i]} ответила правильно?', parent=w):
                    self.scores[i] += bs[i]
                else:
                    self.scores[i] -= bs[i]
                    
            w.destroy()
            self.host_board()
            self.projector_board('ИТОГИ ИГРЫ')
            winner = max(range(3), key=lambda i: self.scores[i])
            messagebox.showinfo('Итоги', f'🏆 Победитель: {self.names[winner]}\n\n' + '\n'.join(f'{self.names[i]}: {self.scores[i]}' for i in range(3)))
            
        tk.Button(w, text='ПОДВЕСТИ ИТОГИ', command=finish, bg=ORANGE, fg=BG, relief='flat', bd=0, font=(FONT, 15, 'bold'), padx=20, pady=10).pack(pady=25)

if __name__ == '__main__':
    root = tk.Tk()
    Game(root)
    root.mainloop()
