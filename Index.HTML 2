class Game:
    def __init__(self, root):
        self.r = root
        root.title('СВОЯК — Пульт ведущего')
        root.geometry('1000x760')
        root.configure(bg=BG)
        
        self.names = ['Команда 1', 'Команда 2', 'Команда 3']
        self.scores = [0, 0, 0]
        self.used = set()
        
        self.projector = tk.Toplevel(root)
        self.projector.title('СВОЯК — Экран для проектора')
        self.projector.configure(bg=BG)
        self.projector.protocol("WM_DELETE_WINDOW", self.close_projector)
        self._place_projector_on_second_monitor()
        
        self.p_full = True
        self.make_start()

    def ensure_projector(self):
        if not self.projector.winfo_exists():
            self.projector = tk.Toplevel(self.r)
            self.projector.title('СВОЯК — Экран для проектора')
            self.projector.configure(bg=BG)
            self.projector.protocol("WM_DELETE_WINDOW", self.close_projector)
            self._place_projector_on_second_monitor()
        self.projector.deiconify()

    def close_projector(self):
        self.projector.withdraw()

    def _place_projector_on_second_monitor(self):
        try:
            import ctypes
            from ctypes import wintypes
            
            monitors = []
            def collect(hmon, hdc, rect, data):
                r = rect.contents
                monitors.append((r.left, r.top, r.right - r.left, r.bottom - r.top))
                return 1
                
            MONITORENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_int, wintypes.HMONITOR, wintypes.HDC, ctypes.POINTER(wintypes.RECT), wintypes.LPARAM)
            ctypes.windll.user32.EnumDisplayMonitors(0, 0, MONITORENUMPROC(collect), 0)
            
            if len(monitors) > 1:
                target = monitors[1]
                for m in monitors:
                    if m[0] != 0 or m[1] != 0:
                        target = m
                        break
                x, y, w, h = target
                self.projector.geometry(f'{w}x{h}+{x}+{y}')
                self.projector.overrideredirect(True) 
            else:
                self.projector.geometry('1280x720+100+100')
        except Exception:
            self.projector.geometry('1280x720+1000+0')

    def clear(self, w):
        try:
            if w.winfo_exists():
                for x in w.winfo_children():
                    x.destroy()
        except Exception:
            pass

    def lab(self, p, t, size=14, color=WHITE, bg=BG, bold=False, **kw):
        # Обновленный шрифт с поддержкой семейства
        return tk.Label(p, text=t, font=(FONT_MAIN, size, 'bold' if bold else 'normal'), fg=color, bg=bg, **kw)

    def make_start(self):
        self.clear(self.r)
        f = tk.Frame(self.r, bg=BG)
        f.pack(expand=True)
        
        self.lab(f, 'С В О Я К', 40, GOLD, bold=True).pack(pady=(40, 10))
        self.lab(f, 'ПУЛЬТ ВЕДУЩЕГО', 16, CYAN, bold=True).pack(pady=(0, 30))
        self.lab(f, 'Введите названия команд:', 14, WHITE).pack(pady=(10, 15))
        
        self.entries = []
        for i in range(3):
            e = tk.Entry(f, font=(FONT_MAIN, 16), justify='center', width=28, bg=BLUE, fg=WHITE, insertbackground=WHITE, relief='flat', bd=8)
            e.insert(0, self.names[i])
            e.pack(pady=8)
            self.entries.append(e)
            
        tk.Button(f, text='НАЧАТЬ ИГРУ', font=(FONT_MAIN, 16, 'bold'), bg=GOLD, fg=BG, activebackground='#FFC107', activeforeground=BG, relief='flat', bd=0, command=self.start, padx=40, pady=12).pack(pady=30)
        tk.Button(f, text='Показать/Скрыть проектор', command=self.toggle_full, bg=BLUE, fg=CYAN, relief='flat', bd=0, font=(FONT_MAIN, 11), padx=15, pady=6).pack()
        
        self.projector_board('ОЖИДАНИЕ НАЧАЛА ИГРЫ')

    def start(self):
        self.names = [e.get().strip() or f'Команда {i+1}' for i, e in enumerate(self.entries)]
        self.host_board()
        self.projector_board()

    def toggle_full(self):
        self.ensure_projector()
        if self.projector.state() == 'normal':
            self.close_projector()
        else:
            self.projector.deiconify()

    def host_board(self):
        self.clear(self.r)
        top = tk.Frame(self.r, bg=BG)
        top.pack(fill='x', padx=20, pady=20)
        self.lab(top, 'ПУЛЬТ ВЕДУЩЕГО', 20, GOLD, bold=True).pack(side='left')
        tk.Button(top, text='Скрыть/Показать проектор', command=self.toggle_full, bg=BLUE, fg=CYAN, relief='flat', bd=0, font=(FONT_MAIN, 10), padx=15, pady=5).pack(side='right')
        
        sf = tk.Frame(self.r, bg=BG)
        sf.pack(fill='x', padx=20)
        for i in range(3):
            p = tk.Frame(sf, bg=PANEL, highlightbackground=BLUE, highlightthickness=2)
            p.pack(side='left', expand=True, fill='x', padx=6)
            self.lab(p, self.names[i], 13, WHITE, PANEL, True).pack(pady=(10, 2))
            self.lab(p, str(self.scores[i]), 28, GOLD, PANEL, True).pack(pady=(0, 10))
            
        self.lab(self.r, 'Выберите вопрос на экране проектора', 14, CYAN, bold=True).pack(pady=30)
        
        # Новые стильные кнопки ведущего
        btn_style = {'bg': BLUE, 'fg': WHITE, 'activebackground': CYAN, 'activeforeground': BG, 'relief': 'flat', 'bd': 0, 'font': (FONT_MAIN, 12, 'bold'), 'padx': 20, 'pady': 10}
        tk.Button(self.r, text='МОДИФИКАТОРЫ', command=self.modifiers, **btn_style).pack(pady=8)
        tk.Button(self.r, text='ФИНАЛЬНЫЙ ВОПРОС', command=self.final, bg=GOLD, fg=BG, activebackground='#FFC107', activeforeground=BG, relief='flat', bd=0, font=(FONT_MAIN, 13, 'bold'), padx=25, pady=12).pack(pady=12)
        tk.Button(self.r, text='ПОКАЗАТЬ ТАБЛО НА ПРОЕКТОРЕ', command=self.projector_board, **btn_style).pack(pady=8)

    def projector_board(self, status=''):
        self.ensure_projector()
        self.clear(self.projector)
        
        top = tk.Frame(self.projector, bg=BG)
        top.pack(fill='x', padx=40, pady=25)
        self.lab(top, 'С В О Я К', 44, GOLD, bold=True).pack(side='left')
        self.lab(top, 'РАУНД 1  •  6 РУБРИК', 20, CYAN, bold=True).pack(side='right', pady=10)
        
        sf = tk.Frame(self.projector, bg=BG)
        sf.pack(fill='x', padx=30)
        for i in range(3):
            p = tk.Frame(sf, bg=PANEL, highlightbackground=BLUE, highlightthickness=2)
            p.pack(side='left', expand=True, fill='x', padx=8)
            self.lab(p, self.names[i], 16, WHITE, PANEL, True).pack(pady=(12, 4))
            self.lab(p, str(self.scores[i]), 34, CYAN, PANEL, True).pack(pady=(0, 12))
            
        if status:
            self.lab(self.projector, status, 20, WHITE, bold=True).pack(pady=20)
            
        grid = tk.Frame(self.projector, bg=BG)
        grid.pack(expand=True, fill='both', padx=25, pady=20)
        
        for c, cat in enumerate(CATS):
            self.lab(grid, cat, 13, GOLD if cat == 'ШЛАКОБЛОКУНЬ' else CYAN, PANEL, True, wraplength=180, height=2).grid(row=0, column=c, sticky='nsew', padx=4, pady=(0, 10))
            grid.grid_columnconfigure(c, weight=1)
            for rr in range(10):
                key = (c, rr)
                special = SPECIAL.get(key, '')
                text = '✓' if key in self.used else str((rr + 1) * 100) + (('\n' + special) if special else '')
                
                # Плавные карточки вопросов
                btn = tk.Button(grid, text=text, font=(FONT_MAIN, 14, 'bold'), 
                                bg=BLUE if key not in self.used else PANEL, 
                                fg=WHITE if key not in self.used else '#555', 
                                activebackground=CYAN, activeforeground=BG, 
                                relief='flat', bd=0, 
                                command=lambda x=c, y=rr: self.question(x, y), 
                                state='disabled' if key in self.used else 'normal')
                btn.grid(row=rr + 1, column=c, sticky='nsew', padx=4, pady=3)
                grid.grid_rowconfigure(rr + 1, weight=1)

    def modifiers(self):
        w = tk.Toplevel(self.r)
        w.title('Модификаторы')
        w.configure(bg=BG)
        w.geometry('700x540')
        w.transient(self.r)
        self.lab(w, 'МОДИФИКАТОРЫ', 24, GOLD, bold=True).pack(pady=25)
        for n, d in MODS:
            f = tk.Frame(w, bg=PANEL)
            f.pack(fill='x', padx=20, pady=6)
            self.lab(f, n, 15, CYAN, PANEL, True).pack(anchor='w', padx=15, pady=(8, 2))
            self.lab(f, d, 12, WHITE, PANEL, wraplength=620, justify='left').pack(anchor='w', padx=15, pady=(0, 8))

    def question(self, c, r):
        key = (c, r)
        if key in self.used:
            return
        self.used.add(key)
        q, a = Q[c][r]
        v = (r + 1) * 100
        sp = SPECIAL.get(key, 'ОБЫЧНЫЙ ВОПРОС')
        
        self.ensure_projector()
        self.clear(self.projector)
        
        # Экран проектора для вопроса
        self.lab(self.projector, CATS[c], 24, CYAN, bold=True).pack(pady=(80, 10))
        self.lab(self.projector, f'{v} БАЛЛОВ', 20, GOLD, bold=True).pack(pady=10)
        if sp != 'ОБЫЧНЫЙ ВОПРОС':
            self.lab(self.projector, sp, 18, RED, bold=True).pack(pady=15)
        self.lab(self.projector, q, 36, WHITE, bold=True, wraplength=1100, justify='center').pack(expand=True, padx=60)
        self.lab(self.projector, 'СОВЕЩАНИЕ КОМАНД…', 16, CYAN).pack(pady=80)
        
        # Пульт ведущего
        w = tk.Toplevel(self.r)
        w.title('Ответ')
        w.configure(bg=BG)
        w.geometry('780x650')
        w.transient(self.r)
        
        self.lab(w, 'ТОЛЬКО ДЛЯ ВЕДУЩЕГО', 12, CYAN, bold=True).pack(pady=(20, 5))
        self.lab(w, f'{CATS[c]} • {v} баллов', 16, GOLD, bold=True).pack(pady=5)
        if sp != 'ОБЫЧНЫЙ ВОПРОС':
            self.lab(w, f'МОДИФИКАТОР: {sp}', 14, RED, bold=True).pack(pady=5)
            
        self.lab(w, q, 18, WHITE, bold=True, wraplength=700, justify='center').pack(pady=20, padx=20)
        self.lab(w, f'ПРАВИЛЬНЫЙ ОТВЕТ: {a}', 18, GREEN, bold=True, wraplength=700, justify='center').pack(pady=15)
        
        def award(i, ok):
            stake = v
            if sp == 'АУКЦИОН':
                x = simpledialog.askinteger('Аукцион', 'Ставка команды (0–1000):', parent=w, minvalue=0, maxvalue=1000)
                if x is None: return
                stake = x
            if sp == 'ВА-БАНК':
                stake = max(0, self.scores[i])
            if sp == 'УДВОЕНИЕ' and ok:
                stake *= 2
            self.scores[i] += stake if ok else -stake
            w.destroy()
            self.host_board()
            self.projector_board()
            
        frame = tk.Frame(w, bg=BG)
        frame.pack(pady=10)
        for i, n in enumerate(self.names):
            row = tk.Frame(frame, bg=BG)
            row.pack(pady=6)
            self.lab(row, n, 14, WHITE).pack(side='left', padx=10)
            tk.Button(row, text='ВЕРНО +', command=lambda j=i: award(j, True), bg=GREEN, fg=BG, relief='flat', bd=0, font=(FONT_MAIN, 10, 'bold'), padx=10).pack(side='left', padx=4)
            tk.Button(row, text='НЕВЕРНО −', command=lambda j=i: award(j, False), bg=RED, fg=WHITE, relief='flat', bd=0, font=(FONT_MAIN, 10, 'bold'), padx=10).pack(side='left', padx=4)
            
        tk.Button(w, text='Закрыть без начисления', command=lambda: (w.destroy(), self.host_board(), self.projector_board()), bg=BLUE, fg=WHITE, relief='flat', bd=0, font=(FONT_MAIN, 11), padx=15, pady=8).pack(pady=20)

